# Salin ke .env — .env JANGAN pernah di-commit dan tidak ada di repositori.

# NASA FIRMS API key. Ambil gratis di https://firms.modaps.eosdis.nasa.gov/api/map_key/
# Kalau kosong, /api/firms/hotspots mengembalikan 503 dan UI menampilkan state error yang jujur
# (copy sesuai DESIGN_BRIEF Bagian 6) — TIDAK menampilkan hotspot rekaan.
MAP_KEY=

# Base URL inference service tim model. Kosong = Stage 9 (baca mock_data/sample_predictions.json).
# Diisi mulai Stage 10. Lihat komentar di app/services/model_client.py.
MODEL_SERVICE_URL=

# Area of interest default untuk query FIRMS (lat/lon derajat).
AOI_MIN_LAT=-4.5
AOI_MAX_LAT=1.5
AOI_MIN_LON=100.0
AOI_MAX_LON=117.0

# Origin frontend yang diizinkan CORS.
FRONTEND_ORIGIN=http://localhost:5173
